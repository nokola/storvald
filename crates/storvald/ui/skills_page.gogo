// The first page of Storvald: the system skills this program carries on
// the left, the one that is picked on the right.
uses "look.gogo"

style SkillRow padding=10, corner_radius=6 {
    when hovered background=$hover
    when selected background=$pick
}

// First page comes in over nothing, so it has no `on:show`. It comes
// back from the left when the about page over it leaves.
anim skillsBack {
    skillsPage.translate.x from=-30, to=0, duration=0.2, easing=cubic_out
    and skillsPage.opacity from=0, to=1, duration=0.16
}

View skillsPage background=$back, on:uncover=play(skillsBack) {
    Row width=fill, height=fill {
        Panel side width=260, height=fill, background=$side, padding=12 {
            Column spacing=10, width=fill, height=fill {
                Label sideTitle text="System skills", font_size=13, font_color=$dim
                List skillList select=one, spacing=2, width=fill, height=fill, on:change=PickSkill {
                    empty { Label text="No skills", font_color=$dim }
                    repeat skills as $skill by $skill.name {
                        ListItem .SkillRow {
                            Label text=$skill.name, font_size=15, font_color=$ink
                        }
                    }
                }
                Label carried text="", font_size=12, font_color=$dim
                Button aboutButton .QuietButton text="About", on:activate=OpenAbout
            }
        }
        Panel main width=fill, height=fill, padding=24 {
            Column spacing=12, width=fill, height=fill {
                Label skillName text="", font_size=26, font_color=$ink
                Label skillAbout text="", wrap=true, width=fill, font_size=14, font_color=$dim
                Rectangle rule color=$rule, width=fill, height=1
                Scroll skillScroll width=fill, height=fill {
                    Label skillText text="", wrap=true, width=fill, font_size=14, font_color=$ink
                }
            }
        }
    }
}
