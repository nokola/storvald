// The page that places the widgets: each one's signals reach the
// page's `handle` as a variant of its `Handler` (`src/counter_page.rs`).
uses "look.gogo"
uses "stepper.gogo"
uses "size_picker.gogo"
uses "labeled_stepper.gogo"
uses "fader.gogo"

View counterRoot {
    Column halign=left, valign=top, spacing=16, padding=16 {
        Stepper count
        SizePicker size
        LabeledStepper zoom label="Zoom"
        Fader volume
        // Rows the page makes when it loads: each row's Stepper signals
        // with the row's number.
        Column lineList spacing=8 {
            repeat lines {
                Row line spacing=8 {
                    Label text="Line", width=80
                    Stepper amount
                }
            }
        }
        Button reset text="Reset", width=120, height=40
    }
}
