// The first page: the notes, and the two buttons that open the other
// pages.
uses "look.gogo"

// Program's first page comes in over nothing, so it has no `on:show`.
// It comes back from the left when a fullscreen page over it leaves.
anim homeBack {
    homePage.translate.x from=-30, to=0, duration=0.2, easing=cubic_out
    and homePage.opacity from=0, to=1, duration=0.16
}

View homePage background=$back, padding=16, on:uncover=play(homeBack) {
    Column spacing=10, width=fill, height=fill {
        Row spacing=8 {
            // Picture from the program's own `assets` folder: the build
            // puts the file into the program.
            Image noteIcon source="res://assets/note.png", size=hug
            Label title text="Notes", font_size=24, font_color=$ink
        }
        List noteList spacing=2, width=fill, height=fill {
            empty { Label text="No notes yet", font_color=$dim }
            repeat notes as $note by $note.key {
                ListItem padding=8 {
                    Label text=$note.text, font_color=$ink
                }
            }
        }
        Row spacing=8 {
            Button addNote .Plain text="Add note"
            Button openSettings .Plain text="Settings"
            Button clearNotes .Plain text="Drop all"
            Button openPaper .Plain text="Paper"
            // A menu: the Popup shows while its Check is checked, above
            // the Check, right edges in line. Back closes it first.
            Check more .Plain {
                Label text="More", font_color=$ink
                Popup moreMenu side=top, align=end, visibility=gone {
                    Column background=$plate, padding=6, spacing=4 {
                        Button aboutNotes .Plain text="About"
                    }
                }
                when selected moreMenu.visibility = visible
            }
        }
        // Empty place: `home_page.rs` places the footer page in it.
        Panel footer width=fill, height=40
    }
}
