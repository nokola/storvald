// Cached page: made once, later open shows same view, text scrolled to
// same place.
uses "look.gogo"
uses "sliding_page.gogo"

// Plays once, when page first shows. Page is made ahead of its first
// open (`preload`), so that is its first open, not when it was made.
anim countIn {
    noteCount.opacity from=0, to=1, duration=0.3
}

View settingsPage .SlidingPage background=$back, padding=16 {
    Column spacing=10, width=fill, height=fill {
        Row spacing=8 {
            // Same picture the home page shows at once. One line without
            // `loading=lazy` makes a picture load at once everywhere, so
            // the mark here changes nothing.
            Image settingsIcon source="res://assets/note.png", size=hug, loading=lazy
            Label title text="Settings", font_size=24, font_color=$ink
        }
        Label noteCount text="", font_color=$dim, on:show=play(countIn)
        // `loading=lazy`: decoded on a thread of its own, shows a frame or
        // more after the page does. `release=unused`: leaves the GPU once
        // no live page names it, and is decoded again at its next show.
        Image banner source="res://assets/banner.jpg", size=hug, loading=lazy, release=unused
        // No file behind this one: page's code makes its pixels
        // (`set_picture` in `settings_page.rs`). A Surface has no size
        // of its own, so the file gives it one.
        Surface madeInCode draw=picture, width=12, height=12
        Scroll body width=fill, height=fill {
            Label bodyText text="", wrap=true, width=fill, font_color=$ink
        }
        Row spacing=8 {
            Button goBack .Plain text="Back"
        }
    }
}
