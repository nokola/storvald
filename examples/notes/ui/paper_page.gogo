// Page with three parts its own code draws, under its nodes. `paper`:
// ruled paper, a texture the page draws on the GPU. `margin`: the red
// margin line, gogo draw commands the page writes. `stamp`: a square the
// page draws with GPU calls of its own, in the pass that draws the
// pages. Root has no background: the paper covers the screen.
uses "look.gogo"
uses "sliding_page.gogo"

View paperPage .SlidingPage {
    Layers width=fill, height=fill {
        Surface paper draw=picture, fit=distort, width=fill, height=fill
        Surface margin draw=commands, width=fill, height=fill
        Surface stamp draw=gpu, width=48, height=48, halign=left, valign=bottom,
            margin_left=24, margin_bottom=24
        Column spacing=10, padding=16, width=fill, height=fill {
            Label title text="Paper", font_size=24, font_color=#202020
            Label hint text="The lines are a texture this page draws.", font_color=#404040
            Row spacing=8 {
                Button goBack .Plain text="Back"
            }
        }
    }
}
